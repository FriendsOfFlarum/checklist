{
    "name": "fof/checklist",
    "description": "Checklists for Flarum",
    "keywords": [
        "flarum"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "homepage": "https://friendsofflarum.org",
    "funding": [
        {
            "type": "website",
            "url": "https://opencollective.com/fof/donate"
        }
    ],
    "support": {
        "issues": "https://github.com/FriendsOfFlarum/checklist/issues",
        "source": "https://github.com/FriendsOfFlarum/checklist",
        "forum": "https://discuss.flarum.org/d/39018"
    },
    "require": {
        "flarum/core": "^2.0.0",
        "flarum/markdown": "*"
    },
    "require-dev": {
        "flarum/phpstan": "^2.0.0",
        "fof/rich-text": "^2.0.0",
        "flarum/testing": "^2.0.0"
    },
    "authors": [
        {
            "name": "FriendsOfFlarum",
            "email": "team@friendsofflarum.org",
            "role": "Developer"
        },
        {
            "name": "Alexander Skvortsov",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "FoF\\Checklist\\": "src/"
        }
    },
    "replace": {
        "askvortsov/flarum-checklist": "*"
    },
    "extra": {
        "flarum-extension": {
            "title": "FoF Checklists",
            "category": "feature",
            "icon": {
                "name": "far fa-check-square",
                "backgroundColor": "#e74c3c",
                "color": "#fff"
            },
            "optionalDependencies": [
                "flarum/bbcode",
                "fof/rich-text"
            ]
        },
        "flarum-cli": {
            "modules": {
                "githubActions": true
            }
        }
    },
    "scripts": {
        "analyse:phpstan": "phpstan analyse",
        "clear-cache:phpstan": "phpstan clear-result-cache",
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php"
    },
    "scripts-descriptions": {
        "analyse:phpstan": "Run static analysis",
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once."
    },
    "minimum-stability": "beta",
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "FoF\\Checklist\\Tests\\": "tests/"
        }
    }
}
